CREATE TABLE addresses (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    street TEXT NOT NULL,
    city TEXT NOT NULL,
    state TEXT NOT NULL,
    postal_code TEXT NOT NULL,
    country TEXT NOT NULL
);

CREATE TABLE customers (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    email TEXT UNIQUE NOT NULL,
    phone TEXT,
    address_id INTEGER NOT NULL,
    FOREIGN KEY (address_id) REFERENCES addresses(id)
);

CREATE TABLE accounts (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    customer_id INTEGER NOT NULL,
    FOREIGN KEY (customer_id) REFERENCES customers(id)
);

CREATE TABLE payments (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    amount REAL NOT NULL,
    payment_time DATETIME NOT NULL
);

CREATE TABLE invoices (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    account_id INTEGER NOT NULL,
    invoice_date DATETIME NOT NULL,
    due_date DATETIME NOT NULL,
    FOREIGN KEY (account_id) REFERENCES accounts(id)
);

CREATE TABLE account_charges(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    payment_id INTEGER NOT NULL,
    invoice_id INTEGER NOT NULL,
    FOREIGN KEY (payment_id) REFERENCES payments(id),
    FOREIGN KEY (invoice_id) REFERENCES invoices(id)
);

CREATE TABLE prepaid_labels (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    label_code TEXT UNIQUE NOT NULL,
    payment_id INTEGER NOT NULL,
    FOREIGN KEY (payment_id) REFERENCES payments(id)
);

CREATE TABLE recipients (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    email TEXT UNIQUE NOT NULL,
    phone TEXT,
    address_id INTEGER NOT NULL,
    FOREIGN KEY (address_id) REFERENCES addresses(id)
);

-- Packages
CREATE TABLE services (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    base_cost REAL NOT NULL,
    per_kg_cost REAL NOT NULL,
    hazard_surcharge REAL NOT NULL,
    intl_surcharge REAL NOT NULL,
    delivery_time_estimate INTEGER NOT NULL
);

CREATE TABLE packages (
    tracking_no TEXT PRIMARY KEY,
    customer_id INTEGER NOT NULL,
    recipient_id INTEGER NOT NULL,
    weight REAL NOT NULL,
    service_code INTEGER NOT NULL,
    is_hazardous INTEGER NOT NULL DEFAULT 0 CHECK (is_hazardous IN (0, 1)),
    is_international INTEGER NOT NULL DEFAULT 0 CHECK (is_international IN (0, 1)),
    payment_id INTEGER NOT NULL,
    expected_delivery_date DATETIME NOT NULL,
    FOREIGN KEY (payment_id) REFERENCES payments(id),
    FOREIGN KEY (customer_id) REFERENCES customers(id),
    FOREIGN KEY (recipient_id) REFERENCES recipients(id),
    FOREIGN KEY (service_code) REFERENCES services(id)
);
--Customs Declarations
CREATE TABLE customs_declarations (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    tracking_no TEXT NOT NULL,
    origin_country TEXT NOT NULL,
    destination_country TEXT NOT NULL,
    total_value REAL NOT NULL,
    FOREIGN KEY (tracking_no) REFERENCES packages(tracking_no)
);

CREATE TABLE customs_items (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    declaration_id INTEGER NOT NULL,
    line_no TEXT NOT NULL,
    item_value REAL NOT NULL,
    FOREIGN KEY (declaration_id) REFERENCES customs_declarations(id)
);
--tracking
CREATE TABLE locations (
    id INTEGER PRIMARY KEY AUTOINCREMENT
);
CREATE TABLE warehouses (
    location_id INTEGER PRIMARY KEY,
    address_id INTEGER NOT NULL,
    FOREIGN KEY (location_id) REFERENCES locations(id),
    FOREIGN KEY (address_id) REFERENCES addresses(id)
);
CREATE TABLE trucks (
    location_id INTEGER PRIMARY KEY,
    plate_no TEXT NOT NULL,
    FOREIGN KEY (location_id) REFERENCES locations(id)
);
CREATE TABLE planes (
    location_id INTEGER PRIMARY KEY,
    tail_no TEXT NOT NULL,
    FOREIGN KEY (location_id) REFERENCES locations(id)
);

CREATE TABLE tracking_events (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    tracking_no TEXT NOT NULL,
    event_time DATETIME NOT NULL,
    location_id INTEGER NOT NULL,
    event_type TEXT NOT NULL,
    FOREIGN KEY (tracking_no) REFERENCES packages(tracking_no),
    FOREIGN KEY (location_id) REFERENCES locations(id)
);

CREATE TABLE delivery (
    event_id INTEGER PRIMARY KEY,
    delivery_time DATETIME NOT NULL,
    signed_by TEXT NOT NULL,
    FOREIGN KEY (event_id) REFERENCES tracking_events(id)
);